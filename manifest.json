{
  "manifest_version": 3,
  "name": "FocusStream",
  "version": "0.1.0",
  "description": "Lifestreams telemetry: an attention-weighted, chronological timeline of your browsing.",
  "permissions": ["storage", "unlimitedStorage", "webNavigation", "tabs", "scripting", "downloads", "idle"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/Readability.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusStream (click to dump sessions to service worker console)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
